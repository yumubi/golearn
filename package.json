{
  "name": "golearn",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vitepress dev docs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "lint": "eslint --cache .",
    "knip": "knip",
    "test:go": "go vet ./... && go test -race -count=1 ./... && cd dnsproxi-go && go vet ./... && go test -race -count=1 ./...",
    "ci": "pnpm run lint && pnpm run knip && pnpm run docs:build && pnpm run test:go"
  },
  "nano-staged": {
    "*.{md,yaml,yml,json,ts,js}": "eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.41.0",
    "nano-staged": "^1.0.2",
    "simple-git-hooks": "^2.14.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.43"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint && pnpm run docs:build"
  }
}
