# Environment Variables


## Env
## Env is the authoritative runtime configuration shape.
#
# Minimum log level for standard output (console).
# (default: 'info')
STD_LOG_LEVEL="info"

# Model API key used for every search request.
MODEL_API_KEY=""

# Model API base URL.
MODEL_BASE_URL=""

# Model ID that answers every search request.
MODEL=""

# Maximum output tokens of one search answer.
MODEL_OUTPUT_LIMIT=""

# Maximum number of web_search server-tool uses per request.
# (default: '10')
WEB_SEARCH_MAX_USES="10"

# Registers the WebFetch tool, which reads one public web page per call with local and reserved networks blocked.
# (default: 'true')
WEB_FETCH_ENABLED="true"

# Timeout of one WebFetch request, including DNS, dialing, redirects and body read.
# (default: '15s')
WEB_FETCH_TIMEOUT="15s"

# Maximum bytes read from a fetched page before it is cut off and marked as truncated (default 2 MiB).
# (default: '2097152')
WEB_FETCH_MAX_BYTES="2097152"

# Maximum characters the WebFetch tool returns to the model.
# (default: '20000')
WEB_FETCH_MAX_CHARS="20000"

# Listen address of the REST API and the MCP endpoint.
# (default: '0.0.0.0:8231')
HTTP_ADDR="0.0.0.0:8231"

# Optional bearer token shared by the REST API and the MCP endpoint; when set every request except /healthz requires it.
AUTH_TOKEN=""

# Maximum allowed size for HTTP request headers (in bytes).
# (default: '2097152')
MAX_HEADER_BYTES="2097152"

# Maximum memory allowed for parsing multipart forms before spilling to disk.
# (default: '67108864')
MAX_MULTIPART_MEMORY="67108864"

# Maximum duration for reading an entire HTTP request, including the body.
# (default: '120s')
READ_TIMEOUT="120s"

# Maximum duration before timing out response writes; it must cover a whole search.
# (default: '300s')
WRITE_TIMEOUT="300s"

# Maximum amount of time to keep idle connections open.
# (default: '30s')
IDLE_TIMEOUT="30s"

